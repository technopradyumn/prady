// examples/hello.pr
// Prady Language — Basic Functions and Variables

fn add(a: Int, b: Int) -> Int {
    return a + b;
}

fn main() {
    let name = "Pradyumn";
    let age: Int = 25;
    let mut counter = 0;

    counter += 1;
    print("Hello " + name);
    print("Age: " + age);
    print("Result of add(10, 20): " + add(10, 20));
}
