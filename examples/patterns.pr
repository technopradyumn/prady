// examples/patterns.pr
// Prady Pattern Matching, Option, Result, and Error Propagation

enum Status {
    Pending,
    Active(Int),
    Completed(String),
    Failed(String),
}

fn describe(status: Status) -> String {
    let message = match status {
        Pending => "Task is waiting in queue",
        Active(id) => "Task running with worker id",
        Completed(summary) => summary,
        Failed(err) => err
    };
    return message;
}

fn loadProfile(id: Int) -> Result<String, Error> {
    let data = fetchRecord(id)?;
    return Ok(data);
}

fn main() {
    print("Pattern matching example ready.");
}
