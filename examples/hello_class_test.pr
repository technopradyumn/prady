import Hai;

Class Hai {
    let a: Int = 3;
    let b: Int = 5;

    fn hello2() {
        print(a + b);
    }
}

fn hello() -> Int {
    print("Hello from function");
    let hai: Hai = Hai();
    hai.hello2();
    return 3000000000 + 232740;
}

fn main() {
    print(3 + 4);
    print("Hello Prady v1.0.0");
    hello();
    print(hello());
}
